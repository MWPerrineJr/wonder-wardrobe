{
  "version": 1,
  "sdk_version": "0.23.0",
  "path": "/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://cdbhpxzlurjxkpzvmzya.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "the-standing-chair-mcp",
      "version": "0.1.0",
      "title": "The Standing Chair"
    },
    "tools": [
      {
        "name": "list_my_shops",
        "title": "List my shops",
        "description": "List all barbershops owned by the signed-in The Standing Chair user.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      },
      {
        "name": "list_shop_services",
        "title": "List shop services",
        "description": "List all services for a shop owned by the signed-in user.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "shop_id": {
              "type": "string",
              "format": "uuid",
              "description": "The shop UUID (from list_my_shops)."
            }
          },
          "required": [
            "shop_id"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "list_shop_bookings",
        "title": "List shop bookings",
        "description": "List upcoming or historical bookings for a shop owned by the signed-in user, optionally filtered by date range.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "shop_id": {
              "type": "string",
              "format": "uuid",
              "description": "The shop UUID."
            },
            "from": {
              "type": "string",
              "format": "date-time",
              "description": "ISO timestamp lower bound (starts_at >= from)."
            },
            "to": {
              "type": "string",
              "format": "date-time",
              "description": "ISO timestamp upper bound (starts_at <= to)."
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 200,
              "description": "Max rows to return (default 50)."
            }
          },
          "required": [
            "shop_id"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "list_shop_feedback",
        "title": "List shop feedback",
        "description": "List customer feedback rows for a shop owned by the signed-in user, optionally filtered by status/sentiment/urgency.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "shop_id": {
              "type": "string",
              "format": "uuid",
              "description": "The shop UUID."
            },
            "status": {
              "type": "string",
              "enum": [
                "new",
                "reviewed",
                "responded",
                "archived"
              ]
            },
            "sentiment": {
              "type": "string",
              "enum": [
                "very_positive",
                "positive",
                "neutral",
                "negative",
                "very_negative"
              ]
            },
            "urgency": {
              "type": "string",
              "enum": [
                "low",
                "medium",
                "high"
              ]
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 200
            }
          },
          "required": [
            "shop_id"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "update_feedback_status",
        "title": "Update feedback status",
        "description": "Mark a customer feedback row as reviewed, responded, or archived. Only works on shops owned by the signed-in user.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "format": "uuid",
              "description": "The customer_feedback row UUID."
            },
            "status": {
              "type": "string",
              "enum": [
                "new",
                "reviewed",
                "responded",
                "archived"
              ]
            }
          },
          "required": [
            "id",
            "status"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      }
    ]
  }
}
