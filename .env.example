# Environment template — copy to `.env.local` (gitignored). Never commit secrets.

# Dedicated scheduler credential for /api/public/jobs/* and survey email.
# Generate with: openssl rand -base64 32
# Store the same value in Supabase Vault as secret name `job_secret`.
JOB_SECRET=

# Public origin used by survey links and pg_cron job callbacks.
APP_URL=
