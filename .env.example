# Environment template — copy to `.env.local` (gitignored). Never commit secrets.

# Dedicated scheduler credential for /api/public/jobs/* and survey email.
# Generate with: openssl rand -base64 32
# Store the same value in Supabase Vault as secret name `job_secret`.
JOB_SECRET=

# Public origin used by survey links, pg_cron callbacks, and Stripe return URLs.
# Local: http://localhost:5173   Production: https://thestandingchair.com
APP_URL=

# Optional extra origins for preview deployments (comma-separated, HTTPS only).
APP_URL_ALLOWLIST=

# Optional daily AI spend caps for background jobs (defaults: 200 / 40).
AI_MAX_ENRICH_PER_DAY=
AI_MAX_REPORTS_PER_DAY=

# How long an unpaid booking hold keeps a chair (5–120, default 30).
BOOKING_HOLD_MINUTES=

# Required. sandbox = test charges; live = real money. Never inferred from
# the presence of STRIPE_LIVE_API_KEY.
PAYMENTS_ENV=sandbox
VITE_PAYMENTS_ENV=sandbox

# Stripe connector ids for the selected PAYMENTS_ENV (not raw sk_ keys).
STRIPE_SANDBOX_API_KEY=
STRIPE_LIVE_API_KEY=
PAYMENTS_SANDBOX_WEBHOOK_SECRET=
PAYMENTS_LIVE_WEBHOOK_SECRET=
LOVABLE_API_KEY=
